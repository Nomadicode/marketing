{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomadicode-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // nomadicode.com is a proxied record, so this route serves it with no DNS change.
  // www redirects to the apex through a Cloudflare redirect rule.
  "routes": [{ "pattern": "nomadicode.com/*", "zone_name": "nomadicode.com" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference used by OpenNext's cache; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nomadicode-site",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "nomadicode-site-cache",
    },
  ],
  "images": {
    // next/image optimisation through Cloudflare Images.
    "binding": "IMAGES",
  },
}
