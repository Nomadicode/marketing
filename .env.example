# Public build-time configuration. Do not place credentials in this file.
NEXT_PUBLIC_SITE_URL=https://nomadicode.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Required: every saved quote sends an email through Brevo (formerly Sendinblue).
# BREVO_FROM_EMAIL must be a verified Brevo sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Nomadicode
QUOTE_NOTIFICATION_EMAIL=

# Optional secondary quote notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_SMS_TO=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
