# Public build-time configuration. Do not place credentials in this file.
NEXT_PUBLIC_SITE_URL=https://nomadicode.com

# Supabase public project configuration. The catalog reads published products
# and clients through Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose these in browser code or commit them.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: every saved contact message sends an email through Brevo (formerly Sendinblue).
# BREVO_FROM_EMAIL must be a verified Brevo sender. If unset, messages are still stored,
# just without an email notification.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Nomadicode
CONTACT_NOTIFICATION_EMAIL=
